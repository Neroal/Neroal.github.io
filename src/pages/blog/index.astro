---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(d);
}
---

<BaseLayout title="Blog — Neroal Wu" description="技術文章、學習筆記與開發心得">
  <div class="blog-wrapper">
    <header class="blog-header">
      <div class="header-label">BLOG</div>
      <h1 class="blog-title">文章</h1>
      <p class="blog-subtitle">技術筆記 · 開發心得 · 學習記錄</p>
    </header>

    <div class="posts-list">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="post-row">
          <div class="post-row-content">
            <h2 class="post-row-title">{post.data.title}</h2>
            {post.data.description && (
              <p class="post-row-desc">{post.data.description}</p>
            )}
            <div class="post-row-meta">
              <time class="post-row-date">{formatDate(post.data.date)}</time>
              <div class="post-row-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
          <span class="post-row-arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 5rem 1.5rem 6rem;
  }

  .blog-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .header-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    margin-bottom: 0.75rem;
  }

  .blog-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .blog-subtitle {
    font-size: 0.95rem;
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .post-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
    gap: 1rem;
  }

  .post-row:last-child {
    border-bottom: none;
  }

  .post-row:hover {
    background: var(--surface);
  }

  .post-row-content {
    flex: 1;
    min-width: 0;
  }

  .post-row-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.4rem;
    line-height: 1.4;
    transition: color 0.15s;
  }

  .post-row:hover .post-row-title {
    color: var(--accent);
  }

  .post-row-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.6rem;
  }

  .post-row-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-row-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-subtle);
  }

  .post-row-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid rgba(129, 140, 248, 0.15);
  }

  .post-row-arrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-subtle);
    transition: color 0.2s, transform 0.2s;
    flex-shrink: 0;
  }

  .post-row:hover .post-row-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
