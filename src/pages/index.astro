---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillBadges from '../components/SkillBadges.astro';
---

<BaseLayout title="Neroal Wu — Backend Engineer & iOS Developer">
  <Hero />

  <div class="content-wrapper">
    <section class="section">
      <About />
    </section>

    <section class="section">
      <Experience />
    </section>

    <section id="projects" class="section">
      <div class="section-header">
        <h2 class="section-heading">作品</h2>
      </div>
      <div class="projects-grid">
        <ProjectCard
          title="Asset Rebalancer"
          description="iOS 投資組合管理 App，支援台股、美股、債券與現金的統一追蹤。整合 TWSE + Yahoo Finance 即時報價與自動匯率換算，搭配可自訂目標比例的智慧再平衡演算法。Firebase 雲端同步，支援 Google／Apple 登入與中英雙語。"
          tags={['Swift', 'SwiftUI', 'Firebase', 'Google Sign-In', 'Apple Sign-In']}
          status="live"
          screenshot="/screenshots/asset-rebalancer.jpg"
          links={{ appStore: 'https://apps.apple.com/tw/app/asset-rebalancer/id6760184993' }}
        />
        <ProjectCard
          title="發票對對碰 (Invoice Swipe Game)"
          description="以台灣統一發票對獎為主題的 iOS 休閒遊戲。三種模式（限時、每日挑戰、無限）各有獨立 Game Center 排行榜；每日挑戰以日期為 RNG 種子，全球玩家面對同一組獎號。音效全程由 AVAudioEngine 程式合成，無任何音訊資源檔。"
          tags={['Swift', 'SwiftUI', 'Game Center', 'AVAudioEngine']}
          status="live"
          screenshot="/screenshots/invoice-swipe-game.jpg"
          links={{ appStore: 'https://apps.apple.com/tw/app/%E7%99%BC%E7%A5%A8%E5%B0%8D%E5%B0%8D%E7%A2%B0/id6773237902' }}
        />
      </div>
    </section>

    <section class="section">
      <SkillBadges />
    </section>
  </div>
</BaseLayout>

<style>
  .content-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 3rem 0;
  }

  .section-header {
    margin-bottom: 1.5rem;
  }

  .section-heading {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
