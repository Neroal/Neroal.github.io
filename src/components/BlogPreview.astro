---
interface BlogPost {
  id: string;
  slug?: string;
  data: {
    title: string;
    date: Date;
    tags: string[];
    description?: string;
  };
}

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('zh-TW', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(d);
}
---

<section class="blog-preview">
  <div class="section-header">
    <h2 class="section-title">最新文章</h2>
    <a href="/blog" class="view-all">全部文章 →</a>
  </div>
  <div class="post-list">
    {posts.map((post) => (
      <a href={`/blog/${post.id}`} class="post-item">
        <div class="post-item-content">
          <h4 class="post-item-title">{post.data.title}</h4>
          {post.data.description && (
            <p class="post-item-desc">{post.data.description}</p>
          )}
          <div class="post-item-meta">
            <time class="post-item-date">{formatDate(post.data.date)}</time>
            <div class="post-item-tags">
              {post.data.tags.slice(0, 2).map((tag) => (
                <span class="post-item-tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
        <span class="post-item-arrow">→</span>
      </a>
    ))}
  </div>
</section>

<style>
  .blog-preview {
    padding: 4rem 0;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .view-all {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--accent);
    transition: color 0.2s;
  }

  .view-all:hover {
    color: #a5b4fc;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .post-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
    gap: 1rem;
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-item:hover {
    background: var(--surface);
  }

  .post-item-content {
    flex: 1;
    min-width: 0;
  }

  .post-item-title {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.3rem;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-item:hover .post-item-title {
    color: var(--accent);
  }

  .post-item-desc {
    font-size: 0.8rem;
    color: var(--text-subtle);
    margin-bottom: 0.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-item-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-item-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-subtle);
  }

  .post-item-tags {
    display: flex;
    gap: 0.3rem;
  }

  .post-item-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid rgba(129, 140, 248, 0.15);
  }

  .post-item-arrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-subtle);
    transition: color 0.2s, transform 0.2s;
    flex-shrink: 0;
  }

  .post-item:hover .post-item-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
