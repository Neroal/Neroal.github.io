---
interface Props {
  title: string;
  description: string;
  tags: string[];
  status: 'live' | 'review' | 'archived';
  links?: {
    github?: string;
    appStore?: string;
    demo?: string;
    blog?: string;
  };
}

const { title, description, tags, status, links = {} } = Astro.props;

const statusConfig = {
  live: { label: 'Live', color: '#4ade80', glow: 'rgba(74, 222, 128, 0.5)' },
  review: { label: 'Review 中', color: '#fbbf24', glow: 'rgba(251, 191, 36, 0.5)' },
  archived: { label: 'Archived', color: '#71717a', glow: 'transparent' },
};

const s = statusConfig[status];
---

<div class="project-card">
  <div class="card-header">
    <h4 class="card-title">{title}</h4>
    <span class="status-badge" style={`--dot-color: ${s.color}; --dot-glow: ${s.glow}`}>
      <span class="status-dot"></span>
      {s.label}
    </span>
  </div>
  <p class="card-desc">{description}</p>
  <div class="card-tags">
    {tags.map((tag) => <span class="card-tag">{tag}</span>)}
  </div>
  {Object.keys(links).length > 0 && (
    <div class="card-links">
      {links.github && (
        <a href={links.github} target="_blank" rel="noopener noreferrer" class="card-link">
          GitHub ↗
        </a>
      )}
      {links.appStore && (
        <a href={links.appStore} target="_blank" rel="noopener noreferrer" class="card-link">
          App Store ↗
        </a>
      )}
      {links.demo && (
        <a href={links.demo} target="_blank" rel="noopener noreferrer" class="card-link">
          Demo ↗
        </a>
      )}
      {links.blog && (
        <a href={links.blog} class="card-link">
          Blog →
        </a>
      )}
    </div>
  )}
</div>

<style>
  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .project-card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-subtle);
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .status-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--dot-color);
    box-shadow: 0 0 5px var(--dot-glow);
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background: var(--surface-2);
    color: var(--text-subtle);
    border: 1px solid var(--border);
  }

  .card-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .card-link {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
    transition: color 0.2s;
  }

  .card-link:hover {
    color: #a5b4fc;
  }
</style>
